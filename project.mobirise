      "settings": {
        "main": true,
        "title": "Byreal™ | CEX-grade DEX on Solana",
        "meta_descr": "Explore Byreal, a fully on-chain DEX incubated by Bybit and built on Solana. Find out how Byreal plans to bridge web3 with real assets through hybrid finance combining CEX-grade speed and DeFi transparency.",
        "header_custom": "",
